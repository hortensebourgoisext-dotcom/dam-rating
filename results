  let h=`<div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;flex-wrap:wrap">
    <div style="font-size:22px;font-weight:700">${v}</div>
    ${vd?`<div style="font-size:32px;font-weight:700;font-family:var(--mono);color:${sc_color(vd.avg)}">${vd.avg.toFixed(2)}</div>
    <div style="font-size:13px;display:flex;gap:10px">
      ${vd.yes?`<span>✅ ${vd.yes} Yes</span>`:''}${vd.maybe?`<span>🤔 ${vd.maybe} Maybe</span>`:''}${vd.no?`<span>❌ ${vd.no} No</span>`:''}
    </div>`:''}
  </div>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px">`;
  REVIEWERS.forEach(r=>{
    const s=DATA[r].total?.[v], rec=DATA[r].rec?.[v];
    if(s==null)return;
    h+=`<div class="card" style="min-width:120px;flex:1;margin-bottom:0">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px"><div class="dot" style="background:${RC[r]}"></div><div style="font-size:12px;font-weight:600">${r}</div></div>
      <div style="font-size:26px;font-weight:700;font-family:var(--mono);color:${sc_color(s)};margin-bottom:3px">${s.toFixed(2)}</div>
      ${rec?`<div style="font-size:14px">${ri(rec)} ${rec}</div>`:''}
    </div>`;
  });
  h+=`</div><div class="card"><div class="card-title">Criterion breakdown</div><div style="overflow-x:auto">
  <table class="tbl"><thead><tr><th>Criterion</th>${REVIEWERS.map(r=>`<th class="c">${r}</th>`).join('')}<th class="c">Avg</th></tr></thead><tbody>`;
  vCrit.forEach(([crit,avgs])=>{
    h+=`<tr><td style="font-weight:500">${crit}</td>
    ${REVIEWERS.map(r=>`<td class="hc">${DATA[r].crit?.[crit]?.[v]!=null?badge(DATA[r].crit[crit][v]):'<span style="color:#ccc;font-size:11px">—</span>'}</td>`).join('')}
    <td class="hc">${badge(avgs[v])}</td></tr>`;
  });
  h+=`</tbody></table></div></div>`;
  document.getElementById('vendorContent').innerHTML=h;
}

// ── BY REVIEWER ──
function renderReviewerPills(){
  document.getElementById('reviewerPills').innerHTML=REVIEWERS.map(r=>
    `<button class="pill ${selReviewer===r?'active':''}" onclick="selectReviewer('${r}')" style="${selReviewer===r?`background:${RC[r]};border-color:${RC[r]}`:''}">${r}</button>`
  ).join('');
}
function selectReviewer(r){
  selReviewer=r; renderReviewerPills();
  const rev=DATA[r];
  const vscores=VENDORS.map((v,vi)=>({vendor:v,short:VS[vi],score:rev.total?.[v],rec:rev.rec?.[v]})).filter(v=>v.score!=null).sort((a,b)=>b.score-a.score);
  let h=`<div style="font-size:18px;font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:10px">
    <div class="dot" style="background:${RC[r]};width:10px;height:10px"></div>${r}
  </div>
  <div style="font-size:13px;color:var(--g500);margin-bottom:20px">${Object.keys(rev.crit).length} criteria rated · ${vscores.length} vendors scored</div>
  <div class="card">`;
  vscores.forEach(v=>{
    h+=`<div class="pbar-wrap"><div class="pbar-top"><span style="font-weight:600">${v.vendor}</span>
    <div style="display:flex;align-items:center;gap:8px"><span style="font-family:var(--mono);font-weight:700;color:${sc_color(v.score)}">${v.score.toFixed(2)}</span>${v.rec?`<span style="font-size:14px">${ri(v.rec)}</span>`:''}</div></div>
    <div class="pbar"><div class="pbar-fill" style="width:${(v.score/5)*100}%;background:${RC[r]}"></div></div></div>`;
  });
  h+=`</div><div class="card"><div class="card-title">All criterion scores</div><div style="overflow-x:auto">
  <table class="tbl"><thead><tr><th>Criterion</th>${VENDORS.map((_,i)=>`<th class="c" style="font-size:11px">${VS[i]}</th>`).join('')}</tr></thead><tbody>`;
  Object.entries(rev.crit).forEach(([crit,scores],i)=>{
    h+=`<tr style="background:${i%2===0?'var(--g50)':'#fff'}"><td style="font-weight:500">${crit}</td>
    ${VENDORS.map(v=>scores[v]!=null?`<td class="hc">${badge(scores[v])}</td>`:`<td class="hc"><span style="color:#ddd;font-size:11px">—</span></td>`).join('')}</tr>`;
  });
  h+=`</tbody></table></div></div>`;
  document.getElementById('reviewerContent').innerHTML=h;
}

// ── MATRIX ──
function renderMatrix(){
  const criteria=allCriteria(), ranked=avgTotals();
  const sorted=[...ranked].sort((a,b)=>b.avg-a.avg);

  // Group criteria
  const grouped={};
  Object.entries(criteria).forEach(([crit,scores])=>{
    // Detect group from reviewer data
    let grp='Other';
    for(const r of REVIEWERS){
      if(DATA[r].crit?.[crit]){
        // Find which group this criterion belongs to based on the raw data structure
        // We'll infer it from known groupings
        break;
      }
    }
    if(!grouped[grp])grouped[grp]=[];
    grouped[grp].push([crit,scores]);
  });

  let h=`<div style="font-size:13px;color:var(--g500);margin-bottom:20px">Average scores across all reviewers · ${REVIEWERS.length} reviewers so far</div>
  <div style="overflow-x:auto"><table class="tbl">
  <thead><tr><th style="min-width:180px">Criterion</th>${VENDORS.map((_,i)=>`<th class="c" style="min-width:90px">${VS[i]}</th>`).join('')}</tr></thead><tbody>`;

  Object.entries(criteria).forEach(([crit,scores])=>{
    h+=`<tr><td style="font-weight:500">${crit}</td>${VENDORS.map(v=>scores[v]!=null?`<td class="hc">${badge(scores[v])}</td>`:`<td class="hc"><span style="color:#ddd;font-size:11px">—</span></td>`).join('')}</tr>`;
  });

  h+=`<tr class="tot"><td>AVG TOTAL SCORE</td>${VENDORS.map((v,vi)=>{const vd=ranked.find(r=>r.vendor===v);return`<td class="c">${vd?vd.avg.toFixed(2):'—'}</td>`}).join('')}</tr>`;
  h+=`<tr style="background:var(--g50)"><td style="font-weight:600">Recommendations</td>${VENDORS.map(v=>{const vd=ranked.find(r=>r.vendor===v);if(!vd)return`<td class="c">—</td>`;return`<td class="c" style="font-size:13px">${vd.yes?`✅${vd.yes} `:''}${vd.maybe?`🤔${vd.maybe} `:''}${vd.no?`❌${vd.no}`:''}</td>`}).join('')}</tr>`;
  h+=`</tbody></table></div>`;
  document.getElementById('matrixContent').innerHTML=h;
}

init();
</script>

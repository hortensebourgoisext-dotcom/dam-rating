function renderRanking(){
  const ranked = avgTotals();
  let h = `<div style="font-size:11px;font-family:var(--mono);letter-spacing:2px;color:#aaa;text-transform:uppercase;margin-bottom:16px">
    Average across ${REVIEWERS.length} reviewers · 1–5 scale · ${11-REVIEWERS.length} reviewers still pending
  </div><div class="podium">`;
  ranked.forEach((v,i)=>{
    h+=`<div class="pcard ${i===0?'r1':''}" onclick="selectVendor('${v.vendor}')">
      <div class="rank">#${i+1}</div>
      <div class="vn" style="${i!==0?'color:var(--black)':''}">${v.short}</div>
      <div class="sc" style="${i!==0?`color:${sc_color(v.avg)}`:''}">${v.avg.toFixed(2)}</div>
      <div style="font-size:14px;margin-bottom:4px">${v.yes?`✅${v.yes} `:''}${v.maybe?`🤔${v.maybe} `:''}${v.no?`❌${v.no}`:''}</div>
      <div class="votes">${v.scores.length} reviewer${v.scores.length!==1?'s':''}</div>
    </div>`;
  });
  h+=`</div>`;

  // Bar chart
  h+=`<div class="card"><div class="card-title">Score per reviewer × vendor</div><div style="position:relative;height:240px"><canvas id="bc"></canvas></div></div>`;

  // Recs heatmap
  h+=`<div class="card"><div class="card-title">Recommendations</div><div style="overflow-x:auto"><table class="tbl"><thead><tr>
    <th>Reviewer</th>${VENDORS.map((_,i)=>`<th class="c" style="font-size:11px">${VS[i]}</th>`).join('')}
  </tr></thead><tbody>`;
  REVIEWERS.forEach(r=>{
    h+=`<tr><td style="font-weight:600"><div style="display:flex;align-items:center;gap:7px"><div class="dot" style="background:${RC[r]}"></div>${r}</div></td>
    ${VENDORS.map(v=>`<td style="text-align:center;font-size:16px">${ri(DATA[r].rec?.[v])}</td>`).join('')}</tr>`;
  });
  h+=`</tbody></table></div></div>`;
  document.getElementById('rankingContent').innerHTML=h;

  setTimeout(()=>{
    const ctx=document.getElementById('bc');
    if(!ctx)return;
    if(chartInst.bar)chartInst.bar.destroy();
    chartInst.bar=new Chart(ctx,{type:'bar',data:{
      labels:VS,
      datasets:REVIEWERS.map(r=>({label:r,data:VENDORS.map(v=>DATA[r].total?.[v]??null),backgroundColor:RC[r],borderRadius:4,borderSkipped:false}))
    },options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{labels:{font:{family:'DM Sans',size:12},boxWidth:12}}},
      scales:{y:{min:0,max:5,grid:{color:'#f0f0f0'},ticks:{font:{family:'DM Mono',size:11}}},x:{grid:{display:false},ticks:{font:{family:'DM Sans',size:11}}}}}});
  },50);
}


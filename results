const REVIEWERS = Object.keys(DATA);

// ══════════════════ COMPUTED ══════════════════
function avgTotals() {
  return VENDORS.map((v,vi) => {
    const scores = REVIEWERS.map(r => DATA[r].total?.[v]).filter(s => s!=null && !isNaN(s));
    const avg = scores.length ? scores.reduce((a,b)=>a+b,0)/scores.length : null;
    const recs = REVIEWERS.map(r => DATA[r].rec?.[v]).filter(Boolean);
    return {
      vendor:v, short:VS[vi], avg, scores,
      yes:recs.filter(r=>r==='Yes').length,
      maybe:recs.filter(r=>r==='Maybe').length,
      no:recs.filter(r=>r==='No').length,
      recs
    };
  }).filter(v=>v.avg!==null).sort((a,b)=>b.avg-a.avg);
}

function allCriteria() {
  const map = {};
  REVIEWERS.forEach(r => {
    Object.entries(DATA[r].crit||{}).forEach(([crit,scores]) => {
      if (!map[crit]) map[crit] = {};
      Object.entries(scores).forEach(([v,s]) => {
        if (s==null) return;
        if (!map[crit][v]) map[crit][v] = [];
        map[crit][v].push(s);
      });
    });
  });
  const result = {};
  Object.entries(map).forEach(([crit,vmap]) => {
    result[crit] = {};
    Object.entries(vmap).forEach(([v,arr]) => {
      result[crit][v] = arr.reduce((a,b)=>a+b,0)/arr.length;
    });
  });
  return result;
}

// ══════════════════ UTILS ══════════════════
function sc(s){if(s==null)return'na';if(s>=4)return'h';if(s>=3)return'm';return'l'}
function badge(s){if(s==null)return`<span class="sbadge sn">—</span>`;const c=s>=4?'sh':s>=3?'sm':'sl';return`<span class="sbadge ${c}">${typeof s==='number'?s.toFixed(1):s}</span>`}
function ri(r){return r==='Yes'?'✅':r==='No'?'❌':r==='Maybe'?'🤔':'—'}
function sc_color(s){if(s==null)return'#e5e7eb';if(s>=4)return'#16a34a';if(s>=3)return'#d97706';return'#dc2626'}
function showTab(t){
